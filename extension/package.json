{
  "name": "canopy",
  "displayName": "Canopy",
  "description": "Sustainability analysis for your codebase",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "workspaceContains:**/*.ts",
    "workspaceContains:**/*.js"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "canopy",
          "title": "Canopy",
          "icon": "assets/canopy-icon.svg"
        }
      ]
    },
    "views": {
      "canopy": [
        {
          "id": "canopy.features",
          "name": "Features",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "canopy.reanalyze",
        "title": "Canopy: Re-analyze Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "canopy.openDashboard",
        "title": "Canopy: Open Web Dashboard",
        "icon": "$(globe)"
      },
      {
        "command": "canopy.openDiff",
        "title": "Canopy: View Suggestion"
      },
      {
        "command": "canopy.showFeatureInfo",
        "title": "Canopy: Show Feature Info"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "canopy.reanalyze",
          "when": "view == canopy.features",
          "group": "navigation"
        },
        {
          "command": "canopy.openDashboard",
          "when": "view == canopy.features",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "package": "vsce package"
  },
  "dependencies": {
    "eventsource": "^2.0.2"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
